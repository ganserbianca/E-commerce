<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Resources\Json\AnonymousResourceCollection;
use App\Services\AddressService;

class AddressController extends Controller
{
    private AddressService $addressService;
    // cria uma propriedade na classe para guardar uma instância do service 

    public function __construct(AddressService $addressService)
    //recebe o address service por injeção de dependencia e guarda ele para usar depois no controller

    {
        $this->addressService = $addressService;
        //guarda o serviço recebido na propriedade da classe
    }

    public function index(): AnonymousResourceCollection
    //recebe a requisição HTTP atual
    {            
        $addresses = $this->addressService->index(auth()->id());

        return AddressResource::collection($addresses);
    }

    public function show(Request $request, int $id): AddressResource
    {
        $address = $this->addressService->show($request->user()->id, $id);

        return new AddressResource($address);
    }

    public function store(StoreAddressRequest $request): JsonResponse
    {
        $address = $this->addressService->create(auth()->id(), $request->validated());

        return (new AddressResource($address))
        ->response()
        ->setStatusCode(201);
    }

    public function update(Request $request, $id)
    {
       $address = $this->addressService->update(
            $request->user()->id,
            $id,
            $request->validated()
        );

        return new AddressResource($address);
    }

    public function destroy(Request $request, $id)
    {
        $this->addressService->delete(
            $request->user()->id,
            $id
        );

        return response()->json([
            'message' => 'Endereço excluído com sucesso.'
        ]);
    }
}

