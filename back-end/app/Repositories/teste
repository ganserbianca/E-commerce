    {
        return Cart::create($cartData);
    }

    public function update(int $id, array $cartData): Cart
    {
        $cart = $this->find($id);
        $cart->update($cartData);

        return $cart->refresh();
    }

    public function clearItems(Cart $cart): void
    {
        $cart->items()->delete();
    }
